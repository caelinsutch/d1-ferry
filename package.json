{
  "name": "d1-ferry",
  "version": "0.1.0",
  "description": "Move large amounts of data between Cloudflare D1 databases without hitting statement, parameter, or duration limits",
  "keywords": [
    "bulk-insert",
    "bun",
    "cli",
    "cloudflare",
    "d1",
    "data-transfer",
    "database",
    "etl",
    "migration",
    "sqlite"
  ],
  "homepage": "https://github.com/caelinsutch/d1-ferry#readme",
  "bugs": {
    "url": "https://github.com/caelinsutch/d1-ferry/issues"
  },
  "license": "Apache-2.0",
  "author": "Caelin Sutch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caelinsutch/d1-ferry.git"
  },
  "bin": {
    "d1-ferry": "./bin/d1-ferry.ts",
    "d1f": "./bin/d1-ferry.ts"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "bun run bin/d1-ferry.ts",
    "build": "bun build bin/d1-ferry.ts --compile --minify --sourcemap --target=bun --outfile dist/d1-ferry",
    "build:js": "bun build bin/d1-ferry.ts --target=bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
